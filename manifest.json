{
  "manifest_version": 3,
  "name": "SoundCloud Scrobbler",
  "version": "1.0",
  "description": "Renvoie les données lues sur soundcloud.com sur un port local. Utilisé pour le projet https://github.com/nys-Fleinz/soundcloudWidget",
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://soundcloud.com/*"],
      "js": ["scscrobbler.js"]
    }
  ],
  "host_permissions": [
    "*://soundcloud.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
